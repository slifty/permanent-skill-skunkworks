{
	"name": "permanent-claude-plugin",
	"version": "0.1.19",
	"private": true,
	"description": "Claude plugin for curating and archiving stories on Permanent.org",
	"type": "module",
	"engines": {
		"node": ">=22.6"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"smoke": "node --experimental-strip-types src/smoke/check.ts",
		"demo:fake-permanent": "node --experimental-strip-types src/demo/fake-server.ts",
		"demo:sample-photos": "node --experimental-strip-types src/demo/sample-photos.ts",
		"check:bundle": "npm run build && node scripts/check-bundle.mjs",
		"lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:tsc",
		"lint:eslint": "eslint --max-warnings 0 .",
		"lint:prettier": "prettier . --check",
		"lint:tsc": "tsc --noEmit",
		"format": "prettier --write . && eslint . --fix",
		"test": "vitest run"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"exifr": "^7.1.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tsconfig/node22": "^22.0.7",
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"eslint-config-love": "^158.0.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"jpeg-js": "^0.4.4",
		"prettier": "^3.10.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.74.0",
		"vitest": "^5.1.1"
	}
}
